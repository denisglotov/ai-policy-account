# ==============================================================================
# Deployment Configuration for PolicyAccount
# ==============================================================================

# RPC URL for deployment network (e.g. Ethereum Sepolia, Local Anvil, etc.)
RPC_URL=http://127.0.0.1:8545

# Deployer private key in hex (with 0x prefix) used to broadcast deployment
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# AI-Oracle signer public address (REQUIRED)
ORACLE_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Smart account owner address (OPTIONAL: defaults to deployer/broadcaster address if commented out)
# OWNER_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906

# Canonical ERC-4337 v0.7 EntryPoint contract address (OPTIONAL: defaults to 0x0000000071727De22E5E9d8BAf0edAc6f37da032)
ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Initial ETH funding sent to the PolicyAccount upon deployment in wei (OPTIONAL: defaults to 0)
INITIAL_FUNDING=0
